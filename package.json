{
  "name": "chrome-extension-starter",
  "version": "0.0.0-development",
  "private": true,
  "description": "TypeScript Manifest V3 browser extension starter",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets": "secretlint \"**/*\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && node --test tests/build-check.mjs",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run test:package && npm run secrets",
    "prepare": "husky",
    "hooks": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "secretlint": "^13.0.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.31.1",
    "vitest": "^5.0.5"
  }
}
